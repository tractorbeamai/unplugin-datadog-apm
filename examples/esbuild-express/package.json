{
  "name": "example-esbuild-express",
  "version": "0.0.2",
  "private": true,
  "description": "Example Express API bundled with esbuild and unplugin-datadog-apm",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --watch --import unplugin-datadog-apm/register dist/server.mjs",
    "start": "node --import unplugin-datadog-apm/register dist/server.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "dd-trace": "^5.84.0",
    "express": "^5.1.0",
    "unplugin-datadog-apm": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.2.0",
    "esbuild": "^0.25.6",
    "typescript": "^5.9.3"
  }
}
