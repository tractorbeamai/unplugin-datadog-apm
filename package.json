      "api": [
        "./dist/api.d.mts"
      ],
      "esbuild": [
        "./dist/esbuild.d.mts"
      ],
      "init": [
        "./dist/init.d.mts"
      ],
      "nitro-plugin": [
        "./dist/nitro-plugin.d.mts"
      ],
      "register": [
        "./dist/register.d.mts"
      ],
      "register-helpers": [
        "./dist/register-helpers.d.mts"
      ],
      "rolldown": [
        "./dist/rolldown.d.mts"
      ],
      "rollup": [
        "./dist/rollup.d.mts"
      ],
      "rspack": [
        "./dist/rspack.d.mts"
      ],
      "vite": [
        "./dist/vite.d.mts"
      ],
      "webpack": [
        "./dist/webpack.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "pnpm lint:types && pnpm lint:eslint && pnpm lint:format",
    "lint:eslint": "eslint",
    "lint:format": "prettier --check .",
    "lint:types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm build && changeset publish",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
