    "dd-trace": "^5.84.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "jiti": "^2.6.1",
    "nock": "^14.0.10",
    "prettier": "^3.8.1",
    "rolldown": "1.0.0-rc.2",
    "rollup": "^4.57.1",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
