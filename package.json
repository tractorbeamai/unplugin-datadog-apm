{
  "name": "unplugin-datadog-apm",
  "version": "0.0.0",
  "description": "Unplugin for Datadog APM instrumentation in bundled Node.js applications",
  "keywords": [
    "unplugin",
    "datadog",
    "apm",
    "dd-trace",
    "tracing",
    "vite",
    "webpack",
    "rspack",
    "rollup",
    "rolldown",
    "esbuild",
    "farm"
  ],
  "homepage": "https://github.com/tractorbeamai/unplugin-datadog-apm#readme",
  "bugs": {
    "url": "https://github.com/tractorbeamai/unplugin-datadog-apm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tractorbeamai/unplugin-datadog-apm.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./api": "./dist/api.js",
    "./esbuild": "./dist/esbuild.js",
    "./farm": "./dist/farm.js",
    "./init": "./dist/init.js",
    "./nitro-plugin": "./dist/nitro-plugin.js",
    "./rolldown": "./dist/rolldown.js",
    "./rollup": "./dist/rollup.js",
    "./rspack": "./dist/rspack.js",
    "./vite": "./dist/vite.js",
    "./webpack": "./dist/webpack.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "pnpm lint:types && pnpm lint:eslint && pnpm lint:format",
    "lint:eslint": "eslint",
    "lint:format": "prettier --check .",
    "lint:types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm build && changeset publish",
    "test": "vitest"
  },
  "prettier": "@tractorbeam/prettier-config",
  "dependencies": {
    "acorn": "^8.15.0",
    "consola": "^3.4.2",
    "exsolve": "^1.0.8",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@anthropic-ai/sdk": "^0.72.1",
    "@changesets/cli": "^2.29.8",
    "@eslint/compat": "^2.0.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tractorbeam/eslint-config": "^0.3.0",
    "@tractorbeam/prettier-config": "^0.1.2",
    "@tractorbeam/typescript-config": "^0.3.0",
    "@types/node": "^25.2.0",
    "ai": "^6.0.68",
    "dd-trace": "^5.84.0",
    "eslint": "^9.39.2",
    "jiti": "^2.6.1",
    "nock": "^14.0.10",
    "openai": "^6.17.0",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tsdown": "^0.20.1",
    "tsdown-preset-sxzz": "^0.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "dd-trace": ">=5.0.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
