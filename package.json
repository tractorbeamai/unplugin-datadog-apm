{
  "name": "unplugin-datadog-apm",
  "version": "0.1.0",
  "description": "Unplugin for Datadog APM instrumentation in bundled Node.js applications",
  "keywords": [
    "unplugin",
    "datadog",
    "apm",
    "dd-trace",
    "tracing",
    "vite",
    "webpack",
    "rspack",
    "rollup",
    "rolldown",
    "esbuild"
  ],
  "homepage": "https://github.com/tractorbeamai/unplugin-datadog-apm#readme",
  "bugs": {
    "url": "https://github.com/tractorbeamai/unplugin-datadog-apm/issues"
  },
  "repository": {
